{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "separateMinorPatch": true,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Baseline labels by update type",
      "matchUpdateTypes": ["patch"],
      "addLabels": ["routine-update"]
    },
    {
      "description": "Baseline labels by update type",
      "matchUpdateTypes": ["minor", "major"],
      "addLabels": ["manual-review"]
    },
    {
      "matchPackageNames": ["caddy"],
      "addLabels": ["caddy"],
      "matchUpdateTypes": ["patch"],
      "commitMessagePrefix": "fix(caddy): "
    },
    {
      "matchPackageNames": ["caddy"],
      "addLabels": ["caddy"],
      "matchUpdateTypes": ["minor", "major"],
      "commitMessagePrefix": "feat(caddy)!: "
    },
    {
      "matchPackageNames": ["caddy-dns/cloudflare"],
      "addLabels": ["cloudflare"],
      "commitMessagePrefix": "chore(cloudflare): "
    },
    {
      "matchPackageNames": ["ghcr.io/almalinux/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{8})$",
      "addLabels": ["alma"]
    },
    {
      "matchPackageNames": ["ghcr.io/almalinux/**"],
      "matchUpdateTypes": ["patch"],
      "commitMessagePrefix": "fix(alma): "
    },
    {
      "matchPackageNames": ["ghcr.io/almalinux/**"],
      "matchUpdateTypes": ["minor", "major"],
      "commitMessagePrefix": "feat(alma)!: "
    }
  ]
}
